# ================================
# SERVER
# ================================
NODE_ENV=production
PORT=5000
BACKEND_URL=http://your-domain.com/api

# ================================
# DATABASE
# ================================
MONGO_URI=mongodb+srv://admin:Sakethbalu@m0.8vwfsmh.mongodb.net/?appName=M0

# ================================
